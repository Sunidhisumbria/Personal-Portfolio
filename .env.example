# Neon Postgres connection string (stores contact form messages)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Resend API key, from https://resend.com/api-keys (sends you an email per message)
RESEND_API_KEY="re_..."

# Where contact form notifications are delivered (must be your Resend account email
# until you verify a domain in Resend)
CONTACT_TO_EMAIL="sunidhisumbria@gmail.com"
